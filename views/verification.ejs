<%- include('partials/header') %><section class="page-title"><span class="eyebrow">CAMPUSLOOP VERIFICATION CENTER</span><h1>A little more confidence.</h1><p class="muted"><%= p.title %></p></section><div class="form-layout"><div class="panel"><span class="badge"><%= v?.status||'Not submitted' %></span><p><%= v?.notes||'Submit identity evidence for owner review. Format checks are evidence checks, not a guarantee of authenticity.' %></p><form method="post" enctype="multipart/form-data" class="stack" action="/listings/<%= p.id %>/verification"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Identifier type<select name="kind"><% ['Serial','IMEI','ISBN','SKU'].forEach(k=>{ %><option <%= v?.kind===k?'selected':'' %>><%= k %></option><% }) %></select></label><label>Private identifier<input name="identifier" required minlength="4" maxlength="64" value="<%= v?.identifier||'' %>"></label><label class="upload-area">Upload private proof<input type="file" name="evidence" accept="image/jpeg,image/png,image/webp" multiple required><small>Serial label, device screen, receipt, or packaging. Up to 6 images, 5 MB each.</small></label><button class="button">Submit evidence →</button></form><h3>Submitted evidence</h3><div class="gallery-thumbs"><% evidence.forEach(e=>{ %><a href="/evidence/<%= e.id %>" target="_blank" rel="noreferrer"><img src="/evidence/<%= e.id %>" alt="Private verification proof"></a><% }) %></div><h3>Review history</h3><% history.forEach(h=>{ %><p><strong><%= h.action %></strong><small><%= h.created_at %> · <%= h.details %></small></p><% }) %></div><aside class="panel"><h3>Your evidence stays private.</h3><p>Only you and the owner can view identifiers and proof images.</p><p><%= verificationExplanation %></p><% if(v){ %><h3>Evidence checks</h3><% Object.entries(JSON.parse(v.checks)).forEach(([k,val])=>{ %><p><%= val?'✓':'○' %> <%= k %></p><% }) %><% } %></aside></div><%- include('partials/footer') %>
