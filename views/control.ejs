<%- include('partials/header') %><div class="control-layout"><aside class="control-nav"><span class="eyebrow">OWNER WORKSPACE</span><h3>In control<span class="logo-dot">.</span></h3><% Object.entries({overview:'Overview',listings:'Listings',verification:'Verification Center',users:'Users',owners:'Owner logins',categories:'Categories',analytics:'Analytics',reports:'Reports',settings:'Website & settings'}).forEach(([k,v])=>{ %><a class="<%= section===k?'selected':'' %>" href="<%= k==='overview'?'/control':'/control/'+k %>"><%= v %></a><% }) %><p class="fine">Private workspace<br>Owner access only</p></aside><section class="control-content"><div class="page-title"><span class="eyebrow">CAMPUSLOOP CONTROL PANEL</span><h1><%= {overview:'The big picture.',listings:'Keep the loop useful.',verification:'Evidence. Reviewed.',users:'Your campus community.',categories:'A place for every essential.',analytics:'See what’s moving.',reports:'Keep your community safe.',settings:'Make CampusLoop yours.'}[section] %></h1></div><% if(section==='overview'||section==='analytics'){const views=products.reduce((s,p)=>s+p.views,0),contacts=products.reduce((s,p)=>s+p.contacts,0); %><div class="metrics"><% [['Total users',users.length],['Buyers',users.filter(u=>u.role==='buyer').length],['Sellers',users.filter(u=>u.role==='seller').length],['Live listings',products.filter(p=>p.status==='ACTIVE').length],['Pending',products.filter(p=>p.status==='PENDING').length],['Rejected',products.filter(p=>p.status==='REJECTED').length],['Verified',requests.filter(v=>v.status==='Verified').length],['Verification requests',requests.filter(v=>['Under review','Needs more evidence'].includes(v.status)).length],['Listing views',views],['Seller contacts',contacts],['Contact rate',`${views?(100*contacts/views).toFixed(1):0}%`]].forEach(([k,v])=>{ %><div class="panel"><span class="muted"><%= k %></span><strong><%= v %></strong></div><% }) %></div><div class="two-grid"><div class="panel"><h3>Most viewed essentials</h3><% [...products].sort((a,b)=>b.views-a.views).slice(0,5).forEach(p=>{ %><div class="rank-row"><span><%= p.title %></span><strong><%= p.views %></strong></div><% }) %></div><div class="panel"><h3>Most seller contacts</h3><% [...products].sort((a,b)=>b.contacts-a.contacts).slice(0,5).forEach(p=>{ %><div class="rank-row"><span><%= p.title %></span><strong><%= p.contacts %></strong></div><% }) %></div></div><% if(section==='analytics'){ %><div class="three-grid"><% for(const field of ['category','university','seller_name']){const groups={};products.forEach(p=>{groups[p[field]]=(groups[p[field]]||0)+p.views;}); %><div class="panel"><h3><%= {category:'Category',university:'University',seller_name:'Seller'}[field] %> activity</h3><% Object.entries(groups).sort((a,b)=>b[1]-a[1]).forEach(([k,v])=>{ %><div class="rank-row"><span><%= k %></span><strong><%= v %> views</strong></div><% }) %></div><% } %></div><% } %><div class="panel"><h3>Recent marketplace activity</h3><% activity.slice(0,30).forEach(a=>{ %><div class="rank-row"><span><%= a.action %><small><%= a.details %></small></span><time><%= a.created_at %></time></div><% }) %><% if(!activity.length){ %><p class="muted">Activity will appear as your community grows.</p><% } %></div><% } %><% if(section==='listings'){ %><form class="search-row" method="get"><label class="sr-only" for="admin-search">Search listings</label><input id="admin-search" name="q" value="<%= q %>" placeholder="Search title, seller, status..."><button class="button">Search</button></form><% const filtered=products.filter(p=>(p.title+' '+p.seller_name+' '+p.status).toLowerCase().includes(q.toLowerCase()));if(!filtered.length){ %><div class="empty"><h3>You’re all caught up.</h3><p>Nothing is waiting for review.</p></div><% } %><% filtered.forEach(p=>{ %><article class="panel moderation-card"><div><span class="badge"><%= p.status %></span><% if(p.featured){ %><span class="badge mint">Featured</span><% } %><h3><%= p.title %></h3><p class="muted"><%= p.seller_name %> · $<%= p.price %> · <%= p.category %> · <%= p.university %></p><p><%= p.description %></p><% if(p.image){ %><img class="thumb" src="<%= p.image %>" alt="<%= p.title %>"><% } %><a class="text-link" href="/listings/<%= p.id %>/edit">Edit all product details →</a></div><form method="post" action="/control/listings/<%= p.id %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Review notes<textarea name="notes" maxlength="1000"><%= p.moderation_note %></textarea></label><div class="actions"><% Object.entries({approve:'Approve',reject:'Reject',changes:'Request changes',deactivate:'Deactivate',activate:'Reactivate',sold:'Mark sold',feature:'Feature',unfeature:'Unfeature',delete:'Delete'}).forEach(([k,v])=>{ %><button class="button small <%= k==='approve'?'':'secondary' %>" name="action" value="<%= k %>" <%= k==='delete'?'data-delete':'' %>><%= v %></button><% }) %></div></form></article><% }) %><% } %><% if(section==='verification'){ %><% if(!requests.length){ %><div class="empty"><h3>You’re all caught up.</h3><p>No verification requests are waiting.</p></div><% } %><% requests.forEach(v=>{ %><article class="panel"><span class="badge"><%= v.status %></span><h3><%= v.title %></h3><p class="muted"><%= v.seller_name %> · <%= v.brand %> · <%= v.model %></p><details><summary><%= v.kind %>: ••••<%= v.identifier.slice(-4) %> — show private evidence</summary><p>Full identifier: <strong><%= v.identifier %></strong></p><a href="/listings/<%= v.product_id %>/verification" class="text-link">View proof images & review history →</a><% if(v.brand.toLowerCase().includes('apple')){ %><p><a href="https://checkcoverage.apple.com/" target="_blank" rel="noreferrer">Official Apple coverage lookup ↗</a></p><% } %></details><div class="checks"><% Object.entries(JSON.parse(v.checks)).forEach(([k,val])=>{ %><span><%= val?'✓':'○' %> <%= k %></span><% }) %></div><form method="post" action="/control/verification/<%= v.product_id %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Review notes<textarea name="notes" maxlength="2000"><%= v.notes %></textarea></label><div class="actions"><% ['Verified','Verification failed','Needs more evidence','Not submitted'].forEach(s=>{ %><button class="button small <%= s==='Verified'?'':'secondary' %>" name="status" value="<%= s %>"><%= s==='Not submitted'?'Reset verification':s %></button><% }) %></div></form></article><% }) %><% } %><% if(section==='users'){ %><div class="table-wrap"><table><thead><tr><th>Student</th><th>Role</th><th>Campus</th><th>Joined</th><th>Listings</th><th>Status / action</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small><%= u.email %></small></td><td><%= u.role %></td><td><%= u.university %><small><%= u.location %></small></td><td><%= u.created_at.slice(0,10) %></td><td><a href="/control/listings?q=<%= encodeURIComponent(u.name) %>"><%= u.listing_count %> listings</a></td><td><%= u.suspended?'Suspended':'Active' %><% if(u.role!=='admin'){ %><form method="post" action="/control/users/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" name="action" value="<%= u.suspended?'restore':'suspend' %>"><%= u.suspended?'Restore':'Suspend' %></button></form><% } %></td></tr><% }) %></tbody></table></div><% } %><% if(section==='categories'){ %><p class="muted">Lower positions appear first. Hiding a category hides its public listings.</p><% allCategories.forEach(c=>{ %><form class="panel category-row" method="post" action="/control/categories"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><label>Name<input name="name" value="<%= c.name %>" required></label><label>Position<input name="position" type="number" value="<%= c.position %>" required></label><label class="check"><input type="checkbox" name="hidden" value="1" <%= c.hidden?'checked':'' %>> Hidden</label><button class="button small">Save</button></form><% }) %><form class="panel stack" method="post" action="/control/categories"><h3>Add a category</h3><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" required minlength="2"></label><label>Position<input type="number" name="position" value="10" required></label><button class="button">Add category</button></form><% } %><% if(section==='settings'){ %><form class="panel stack" method="post" action="/control/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><% Object.entries({announcement:'Announcement',headline:'Homepage headline',description:'Homepage description',marketplace_headline:'Marketplace headline',featured_categories:'Featured categories (comma separated)',safety_notice:'Safety notice'}).forEach(([k,v])=>{ %><label><%= v %><textarea name="<%= k %>" maxlength="2000" rows="3"><%= settings[k] %></textarea></label><% }) %><button class="button">Save website content →</button></form><% } %><% if(section==='reports'){ %><% if(!reports.length){ %><div class="empty"><h3>No reports to review.</h3><p>Your community is looking good.</p></div><% } %><% reports.forEach(r=>{ %><article class="panel"><span class="badge"><%= r.resolved?'Resolved':'Open report' %></span><h3><%= r.title %></h3><p><%= r.reason %></p><a class="text-link" href="/control/listings?q=<%= encodeURIComponent(r.title) %>">Review listing →</a><% if(!r.resolved){ %><form method="post" action="/control/reports/<%= r.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button small">Mark resolved</button></form><% } %></article><% }) %><% } %></section></div><%- include('partials/footer') %>
