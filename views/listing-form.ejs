<%- include('partials/header') %><section class="page-title"><span class="eyebrow">GIVE IT A NEXT CHAPTER</span><h1><%= product?'Edit your listing':'Put it in the loop.' %></h1><p class="muted">Be specific. Great details help the right student find you.</p></section><section class="form-layout"><form class="panel stack" method="post" enctype="multipart/form-data" action="<%= product?'/listings/'+product.id+'/edit':'/sell' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Exact product title<input name="title" value="<%= product?.title||'' %>" placeholder="Apple MacBook Air M1 2020 — 8GB / 256GB" minlength="12" maxlength="160" required></label><div class="two-grid"><label>Category<select name="category_id" required><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= product?.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Condition<select name="condition"><% ['New','Like new','Good','Fair'].forEach(c=>{ %><option <%= product?.condition===c?'selected':'' %>><%= c %></option><% }) %></select></label><label>Brand / publisher<input name="brand" value="<%= product?.brand||'' %>" required minlength="2"></label><label>Model / edition<input name="model" value="<%= product?.model||'' %>" required minlength="2"></label><label>Author (required for textbooks)<input name="author" value="<%= product?.author||'' %>"></label><label>Price (USD)<input type="number" name="price" step="0.01" min="0.01" max="100000" value="<%= product?.price||'' %>" required></label><label>University<input name="university" value="<%= product?.university||user.university %>" minlength="2" required></label><label>Pickup location<input name="location" value="<%= product?.location||user.location %>" minlength="2" required></label></div><label>Description<textarea name="description" rows="6" minlength="30" maxlength="5000" required placeholder="Tell buyers about the item, what’s included, wear, and any issues."><%= product?.description||'' %></textarea></label><label class="upload-area">＋ Add product photos<input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple <%= product?'':'required' %>><small>JPG, PNG, WEBP · Up to 6 photos · 5 MB each</small></label><button class="button"><%= product?'Save changes':'Submit for review' %> →</button></form><aside><div class="panel"><h3>A good listing starts with honesty.</h3><p>Include the exact model, condition, and everything the buyer needs to know.</p><p>New listings and seller edits need owner approval before appearing in the marketplace.</p><p>Verification is optional. Submit evidence after creating your listing.</p></div><% images.forEach(i=>{ %><div class="panel"><img class="thumb" src="<%= i.url %>" alt="Existing product photo"><form method="post" action="/listings/<%= product.id %>/images/<%= i.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger">Remove photo</button></form></div><% }) %></aside></section><%- include('partials/footer') %>
