<%- include('partials/header') %><section><a class="text-link" href="/marketplace">← Back to marketplace</a><div class="detail-layout"><div><div class="gallery-main"><img id="main-photo" src="<%= images[0]?.url %>" alt="<%= p.title %>"></div><div class="gallery-thumbs"><% images.forEach(i=>{ %><button data-photo="<%= i.url %>" aria-label="View product photo"><img src="<%= i.url %>" alt="<%= p.title %> additional photo"></button><% }) %></div></div><div class="detail-copy"><span class="eyebrow"><%= p.category %> · <%= p.condition %></span><h1><%= p.title %></h1><div class="detail-price">$<%= Number(p.price).toLocaleString() %></div><% if(p.verification==='Verified'){ %><span class="badge mint">✓ CampusLoop Verified</span><p class="fine"><%= verificationExplanation %></p><% } %><p class="description"><%= p.description %></p><dl><dt>Brand / publisher</dt><dd><%= p.brand %></dd><dt>Model / edition</dt><dd><%= p.model %></dd><% if(p.author){ %><dt>Author</dt><dd><%= p.author %></dd><% } %><dt>University</dt><dd><%= p.university %></dd><dt>Pickup location</dt><dd><%= p.location %></dd></dl><div class="seller-box"><span class="avatar"><%= sellerProfile.name[0] %></span><div><strong><%= sellerProfile.name %></strong><small><%= sellerProfile.university %> · Joined <%= sellerProfile.created_at.slice(0,10) %></small></div></div><form method="post" action="/products/<%= p.id %>/contact" class="two-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button" name="channel" value="whatsapp">WhatsApp seller ↗</button><button class="button secondary" name="channel" value="email">Email seller ↗</button></form><div class="actions"><form method="post" action="/products/<%= p.id %>/favorite"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="remove" value="<%= saved?'1':'0' %>"><button class="link"><%= saved?'♥ Remove saved listing':'♡ Save for later' %></button></form><button class="link" data-share>↗ Share listing</button></div><p class="safety">⌂ <%= settings.safety_notice %></p></div></div></section><section><h2>More in the loop</h2><%- include('partials/cards',{products:related}) %></section><section><details class="panel"><summary>Report a suspicious listing</summary><form method="post" action="/products/<%= p.id %>/report" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>What seems wrong?<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button class="button">Send report</button></form></details></section><%- include('partials/footer') %>
