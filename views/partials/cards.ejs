<div class="product-grid"><% for(const p of products){ %><article class="product-card"><a class="product-image" href="/products/<%= p.id %>"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy"><% }else{ %><div class="image-empty">↻</div><% } %><% if(p.featured){ %><span class="image-badge">Featured</span><% } %></a><div class="card-content"><div class="card-eyebrow"><span><%= p.category %></span><span><%= p.condition %></span></div><h3><a href="/products/<%= p.id %>"><%= p.title %></a></h3><p class="muted location">⌖ <%= p.university %> · <%= p.location %></p><div class="price-row"><strong>$<%= Number(p.price).toLocaleString() %></strong><% if(p.verification==='Verified'){ %><span class="badge mint">✓ Verified</span><% }else{ %><span class="muted">Student listed</span><% } %></div></div></article><% } %></div><% if(!products.length){ %><div class="empty"><span>↻</span><h3>No listings here yet.</h3><p>No listings matched your search. Try adjusting your filters, or put the first item in the loop.</p><a class="button" href="/sell">Sell an item</a></div><% } %>
