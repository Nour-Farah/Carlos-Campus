<%- include('partials/header') %><section class="auth-layout"><div class="auth-story"><span class="eyebrow">YOUR CAMPUS. YOUR COMMUNITY.</span><h1>Good things<br>start here<span class="logo-dot">.</span></h1><p>Find what you need. Pass on what you don’t.<br>Welcome to a more resourceful campus.</p><span class="giant-loop">↻</span></div><div class="panel auth-panel"><% const register=mode==='/register',setup=mode==='/owner/setup',privateLogin=mode==='/owner/login'; %><span class="eyebrow"><%= setup?'FIRST OWNER SETUP':privateLogin?'OWNER PORTAL':'WELCOME TO CAMPUSLOOP' %></span><h2><%= setup?'Set up your owner account':register?'Join the loop':privateLogin?'Owner sign in':'Welcome back' %></h2><form method="post" action="<%= mode %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(register||setup){ %><label>Name<input name="name" autocomplete="name" required minlength="2" maxlength="80"></label><% } %><label>Email<input name="email" type="email" autocomplete="email" required></label><label>Password<input name="password" type="password" autocomplete="<%= register||setup?'new-password':'current-password' %>" minlength="<%= register||setup?12:1 %>" maxlength="128" required></label><% if(register){ %><label>I’m here to<select name="role"><option value="buyer">Buy campus essentials</option><option value="seller">Buy and sell essentials</option></select></label><label>University<input name="university" required minlength="2"></label><label>Location<input name="location" required minlength="2"></label><label>WhatsApp number (optional)<input name="phone" type="tel" placeholder="+961..." pattern="\+?[0-9]{7,15}"></label><% } %><% if(setup){ %><label>Private setup key<input name="setup_key" type="password" required autocomplete="off"></label><p class="muted">Use OWNER_SETUP_KEY from your private environment settings. This setup closes after the first owner is created.</p><% } %><button class="button"><%= register?'Create account':setup?'Create owner account':'Sign in' %> →</button></form><% if(!setup&&!privateLogin){ %><p class="muted"><%= register?'Already in the loop?':'New to CampusLoop?' %> <a class="text-link" href="<%= register?'/login':'/register' %>"><%= register?'Log in':'Join us' %></a></p><% } %></div></section><%- include('partials/footer') %>
