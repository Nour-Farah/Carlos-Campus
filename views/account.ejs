<%- include('partials/header') %><section class="page-title"><span class="eyebrow">YOUR CORNER OF CAMPUSLOOP</span><h1>Hey, <%= user.name.split(' ')[0] %><span class="logo-dot">.</span></h1><p class="muted">Your essentials, connections, and next chapters.</p></section><% if(user.role==='seller'){ %><div class="metrics"><% [['Total listings',products.length],['Active',products.filter(p=>p.status==='ACTIVE').length],['Pending',products.filter(p=>p.status==='PENDING').length],['Sold',products.filter(p=>p.status==='SOLD').length],['Listing views',products.reduce((s,p)=>s+p.views,0)],['Seller contacts',products.reduce((s,p)=>s+p.contacts,0)]].forEach(([k,v])=>{ %><div class="panel"><span class="muted"><%= k %></span><strong><%= v %></strong></div><% }) %></div><section><div class="section-heading"><h2>Your listings</h2><a class="button" href="/sell">＋ New listing</a></div><% if(!products.length){ %><div class="empty"><h3>You haven’t listed anything yet.</h3><p>Put your first item in the loop.</p></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Status</th><th>Verification</th><th>Views / contacts</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><strong><%= p.title %></strong><small><%= p.moderation_note %></small></td><td>$<%= p.price %></td><td><span class="badge"><%= p.status %></span></td><td><%= p.verification||'Not submitted' %></td><td><%= p.views %> / <%= p.contacts %></td><td><div class="actions"><a href="/listings/<%= p.id %>/edit">Edit</a><a href="/listings/<%= p.id %>/verification">Verification</a><form method="post" action="/listings/<%= p.id %>/sold"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Mark sold</button></form><form method="post" action="/listings/<%= p.id %>/delete" data-confirm="Delete this listing permanently?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger">Delete</button></form></div></td></tr><% }) %></tbody></table></div><% } %></section><% } %><section><h2>Saved for later</h2><% if(saved.length){ %><%- include('partials/cards',{products:saved}) %><% }else{ %><div class="empty"><h3>You haven’t saved any listings yet.</h3><p>Find an essential you love and save it for later.</p><a class="text-link" href="/marketplace">Find your next essential →</a></div><% } %></section><section class="panel profile-panel"><h2>Your profile</h2><p class="muted"><%= user.email %> · <%= user.role %></p><form method="post" action="/account" class="two-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" value="<%= user.name %>" required minlength="2"></label><label>University<input name="university" value="<%= user.university %>" required minlength="2"></label><label>Location<input name="location" value="<%= user.location %>" required minlength="2"></label><label>WhatsApp<input name="phone" value="<%= user.phone %>" placeholder="+961..." pattern="\+?[0-9]{7,15}"></label><button class="button">Save profile</button></form></section><%- include('partials/footer') %>
