<%- include('partials/header') %><section class="page-title"><span class="eyebrow">THE MARKETPLACE</span><h1><%= settings.marketplace_headline %></h1><p class="muted">Good things, fair prices, and students just like you.</p></section><div class="market-layout"><aside class="panel"><form action="/marketplace" class="stack"><h3>Find your fit</h3><label>Search<input name="q" value="<%= q.q||'' %>" placeholder="Title, brand, location..."></label><label>Category<select name="category_id"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(q.category_id)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>University<input name="university" value="<%= q.university||'' %>" placeholder="Any university"></label><label>Condition<select name="condition"><option value="">Any condition</option><% ['New','Like new','Good','Fair'].forEach(c=>{ %><option <%= q.condition===c?'selected':'' %>><%= c %></option><% }) %></select></label><div class="two-grid"><label>Min price<input type="number" min="0" name="min" value="<%= q.min||'' %>"></label><label>Max price<input type="number" min="0" name="max" value="<%= q.max||'' %>"></label></div><label class="check"><input type="checkbox" name="verified" value="1" <%= q.verified==='1'?'checked':'' %>> Verified listings only</label><label>Sort by<select name="sort"><% Object.entries({newest:'Newest first',low:'Price: low to high',high:'Price: high to low',views:'Most viewed',popular:'Most seller contacts'}).forEach(([k,v])=>{ %><option value="<%= k %>" <%= q.sort===k?'selected':'' %>><%= v %></option><% }) %></select></label><button class="button">Apply filters</button><a class="text-link" href="/marketplace">Clear filters</a></form></aside><section class="market-results"><p class="muted"><%= products.length %> essentials in the loop<%= products.length===200?' · Showing the first 200; refine your filters.':'' %></p><%- include('partials/cards',{products}) %></section></div><%- include('partials/footer') %>
